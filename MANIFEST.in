# TODO: Generate this manifest file by running the following commands:
#
#  git init
#  git add -A
#  pip install -e .[all]
#  check-manifest -u

# Check manifest will not automatically add these two files:
include .dockerignore
include .editorconfig
include .tx/config
include *.rst
include *.sh
include *.txt
include LICENSE
include babel.ini
include pytest.ini
include .git-blame-ignore-revs
prune docs/_build
recursive-include invenio_circulation *.po *.pot *.mo *.html
recursive-include docs *.png
recursive-include docs *.bat
recursive-include docs *.py
recursive-include docs *.rst
recursive-include docs *.txt
recursive-include docs Makefile
recursive-include tests *.py
recursive-include invenio_circulation *.json

# added by check_manifest.py
recursive-include tests *.json
